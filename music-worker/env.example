# Copy this file to `.env` in music-worker/ and fill it in.
# Never commit the real .env.

# The Convex HTTP-actions origin (.convex.site), not the .convex.cloud one.
CONVEX_SITE_URL=https://quiet-cod-741.convex.site

# Must equal MUSIC_SHARED_SECRET in the Convex deployment environment.
MUSIC_SHARED_SECRET=change-me-to-a-long-random-string

# Lavalink v4. The public Trinium node is the default so /play works without
# hosting one; point these at your own Lavalink for production.
LAVALINK_URL=https://lavalink-v4.triniumhost.com:443
LAVALINK_PASSWORD=free
LAVALINK_NAME=triniumhost

# Port for the worker's own API. Convex calls this through MUSIC_WORKER_URL.
PORT=8099
