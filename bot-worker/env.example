# Copy this file to `.env` in bot-worker/ and fill it in.
# Never commit the real .env.

# The Convex HTTP-actions origin (.convex.site), not the .convex.cloud one.
CONVEX_SITE_URL=https://quiet-cod-741.convex.site

# Must equal WORKER_SHARED_SECRET in the Convex deployment environment.
WORKER_SHARED_SECRET=change-me-to-a-long-random-string

# Port for the worker's own API. Convex calls this through WORKER_URL.
PORT=8099
